{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.rev-iq.ai"
        }
      ],
      "destination": "https://rev-iq.ai/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/skills",
      "destination": "/skills/index.html"
    }
  ]
}