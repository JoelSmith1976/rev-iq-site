{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/private/:path*",
      "destination": "/skills",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.rev-iq.ai"
        }
      ],
      "destination": "https://rev-iq.ai/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/skills",
      "destination": "/skills/index.html"
    }
  ],
  "functions": {
    "api/bundle.js": {
      "includeFiles": "private/bundles/**",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/skills/bundles/download",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
